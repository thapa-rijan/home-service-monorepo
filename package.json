{
  "name": "home-service-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev:website": "turbo run dev --filter=website",
    "dev:admin": "turbo run dev --filter=admin",
    "build:website": "turbo run build --filter=website",
    "build:admin": "turbo run build --filter=admin"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "yarn@1.22.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.2",
    "nookies": "^2.5.2",
    "react-hook-form": "^7.69.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-saga": "^1.4.2",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.1"
  }
}
